# Server Configuration
PORT=5000
HOST=0.0.0.0

# External Inventory System (EIS) Configuration
EIS_BASE_URL=http://localhost:9000/api/v1
EIS_TIMEOUT_MS=10000

# Security Boundary 1: AMS -> Fastify (JWT A)
JWT_A_SECRET=ams-fastify-secret-key-super-secure-token-a
JWT_A_ISSUER=ams
JWT_A_AUDIENCE=integration-service

# Security Boundary 2: Fastify -> EIS (JWT B)
JWT_B_SECRET=fastify-eis-secret-key-super-secure-token-b
JWT_B_ISSUER=integration-service
JWT_B_AUDIENCE=eis
JWT_B_TTL_SECONDS=900
